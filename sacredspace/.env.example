# Required for auth (validated at startup — app throws in dev without these)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: Turso (production database). Falls back to local SQLite
# (./data/sacredspace.db in dev, /tmp on Vercel) when unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Vercel Blob (production file uploads). Falls back to
# public/uploads/ on disk when unset.
BLOB_READ_WRITE_TOKEN=
