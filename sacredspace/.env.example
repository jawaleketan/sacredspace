# Required for auth (validated at startup — app throws in dev without these)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# REQUIRED in production — the app fails fast at startup without it
# (no /tmp SQLite fallback; serverless filesystems are ephemeral).
# Local dev falls back to ./data/sacredspace.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Vercel Blob (production file uploads). Falls back to
# public/uploads/ on disk when unset.
BLOB_READ_WRITE_TOKEN=

# Optional: durable rate limiting via Upstash Redis (REST API, no SDK).
# When both are set, rate-limit counters are shared across serverless
# instances; otherwise per-instance in-memory counters are used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
